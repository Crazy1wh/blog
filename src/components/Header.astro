---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-logo" href="/">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<a href="https://51qdd.com" target="_blank" rel="noopener noreferrer">主站</a>
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--border);
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(16px);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 32px, 960px);
		min-height: 68px;
		margin: 0 auto;
		gap: 24px;
	}
	.site-logo {
		color: var(--text);
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: 0;
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.internal-links a {
		border-radius: 999px;
		color: var(--muted);
		font-size: 0.94rem;
		font-weight: 600;
		line-height: 1;
		padding: 10px 12px;
		text-decoration: none;
	}
	.internal-links a:hover,
	.internal-links a.active {
		background: var(--surface);
		color: var(--text);
	}
	@media (max-width: 640px) {
		nav {
			align-items: flex-start;
			flex-direction: column;
			gap: 12px;
			padding: 16px 0;
		}
		.internal-links {
			flex-wrap: wrap;
			width: 100%;
		}
		.internal-links a {
			padding: 8px 10px;
		}
	}
</style>
